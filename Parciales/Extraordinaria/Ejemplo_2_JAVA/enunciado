🔄 Ejemplo de uso:


Task t1 = new Task("Lavar los platos", 15);
Task t2 = new Task("Hacer la compra", 40);
Task t3 = new Task("Estudiar Java", 120);
Task t4 = new Task("Estudiar Python", 150);
TaskList lista1 = new TaskList();
TaskList lista2 = new TaskList();
lista1.addTask(t1);
lista1.addTask(t2);
lista1.addTask(t3);
lista2.addTask(t4);
System.out.println(lista1);                  // ➡️[Lavar los platos: 15 min]->[Hacer la compra: 40 min]->[Estudiar Java: 120 min]->null
System.out.println(lista1.getTask(1));       // Hacer la compra: 40 min
System.out.println(lista1.getTimeLeft());    // 175
System.out.println(lista1.taskCompleted(1)); // Hacer la compra: 40 min
System.out.println(lista1);                  // ➡️[Lavar los platos: 15 min]->[Estudiar Java: 120 min]->null
System.out.println(lista1.getTimeLeft());    // 135
System.out.println(lista1.getTimeSpent());   // 40
System.out.println(lista1.getTotalTimeSpent()); // 40
System.out.println(lista2.getTask(1));       // Estudiar Pyrhon: 150 min
System.out.println(lista1.getTotalTimeSpent()); // 190