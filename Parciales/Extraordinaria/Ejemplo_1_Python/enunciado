🔄 Ejemplo de uso:

t1 = Task("Lavar los platos", 15)
t2 = Task("Hacer la compra", 40)
t3 = Task("Estudiar Java", 120)
t4 = Task("Estudiar Python", 150)

lista1 = TaskList()
lista2 = TaskList()

lista1.addTask(t1)
lista1.addTask(t2)
lista1.addTask(t3)
lista2.addTask(t4)

print(lista1)                         # ➡️[Lavar los platos: 15 min]->[Hacer la compra: 40 min]->[Estudiar Java: 120 min]->null
print(lista1.getTask(1))              # Hacer la compra: 40 min
print(lista1.getTimeLeft())           # 175
print(lista1.taskCompleted(1))        # Hacer la compra: 40 min
print(lista1)                         # ➡️[Lavar los platos: 15 min]->[Estudiar Java: 120 min]->null
print(lista1.getTimeLeft())           # 135
print(lista1.getTimeSpent())          # 40
print(TaskList.getTotalTimeSpent())   # 40
print(lista2.getTask(1))              # None
print(lista2.taskCompleted(0))        # Estudiar Python: 150 min
print(TaskList.getTotalTimeSpent())   # 190