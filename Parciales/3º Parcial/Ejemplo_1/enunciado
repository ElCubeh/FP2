🔄 Ejemplo de uso:
        InterestGroup group1 = new InterestGroup();
        InterestGroup group2 = new InterestGroup();

        group1.addMember("Ana");
        group1.addMember("Luis");
        group1.addMember("Marta");

        group2.addMember("Luis");
        group2.addMember("Carlos");
        group2.addMember("Elena");

        System.out.println(group1);
        // ➡️ [Marta]->[Luis]->[Ana]->null (El orden no es relavante)

        System.out.println(group1.isMember("Luis")); // true
        System.out.println(group1.getSize()); // 3

        InterestGroup unionGroup = group1.union(group2);
        System.out.println(unionGroup);
        // ➡️ [Elena]->[Carlos]->[Marta]->[Luis]->[Ana]->null (El orden no es relavante)

        unionGroup.remove_member("Elena");
        System.out.println(unionGroup);
        // ➡️ [Carlos]->[Marta]->[Luis]->[Ana]->null